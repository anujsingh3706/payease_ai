# backend/.env.example
# Copy this to .env and fill in your values
# NEVER commit the actual .env file

# ── App ───────────────────────────────────────────────────────
APP_NAME=PayEase AI
APP_VERSION=1.0.0
DEBUG=False

# ── Security (generate with: openssl rand -hex 32) ────────────
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────
# Local:      postgresql://postgres:password@localhost:5432/payease_db
# Render:     postgresql://user:pass@host/db (from Render dashboard)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/payease_db

# ── Groq API (free at console.groq.com) ──────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama3-70b-8192

# ── Razorpay (free test mode at razorpay.com) ────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# ── Email (optional) ──────────────────────────────────────────
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ── CORS ──────────────────────────────────────────────────────
# Local:      http://localhost:5173
# Production: https://payease-frontend.onrender.com
FRONTEND_URL=http://localhost:5173